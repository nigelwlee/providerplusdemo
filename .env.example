# OpenRouter API key — required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model used for analysis. Defaults to a cheap,
# strong-at-structured-JSON model; swap in a stronger/more expensive one
# (e.g. anthropic/claude-sonnet-4.6) if quality needs it for the real pitch.
# OPENROUTER_MODEL=deepseek/deepseek-v3.2

# Optional: how many Practice Standards each parallel analysis call assesses
# at once. Lower = more, faster/smaller parallel calls but more total prompt
# tokens (the document is sent once per batch); higher = fewer, slower calls
# but cheaper. Defaults to 3, which brings a full Core+Module 5A analysis
# down from ~4 minutes (one giant call) to ~15-20s (measured locally).
# ANALYSIS_BATCH_SIZE=3

# Optional: set to "0" to disable OpenRouter's throughput-optimised routing.
# Left on by default — cut the slowest batch call from ~39s to ~13s locally
# with no quality difference.
# OPENROUTER_SORT_THROUGHPUT=0

# Optional: set to any value to log per-call timing/token-usage and batch
# debug info to the server console.
# LLM_DEBUG=1
